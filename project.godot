; Engine configuration file.
; BLACKSITE - tactical single-player FPS
config_version=5

[application]

config/name="BLACKSITE"
config/description="A tactical single-player first-person shooter for Windows PC."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.031, 0.035, 0.039, 1)
boot_splash/show_image=false

[autoload]

Game="*res://autoload/game.gd"
Audio="*res://autoload/audio.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"device":-1)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"device":-1)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"device":-1)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"device":-1)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32,"device":-1)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325,"device":-1)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326,"device":-1)]
}
lean_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81,"device":-1)]
}
lean_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69,"device":-1)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"device":-1)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"device":-1)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82,"device":-1)]
}
weapon_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49,"device":-1)]
}
weapon_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50,"device":-1)]
}
weapon_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51,"device":-1)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4,"device":-1)]
}
weapon_prev={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5,"device":-1)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305,"device":-1)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70,"device":-1)]
}
tactical_light={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":76,"device":-1)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Props"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.031, 0.035, 0.039, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
